#!/usr/bin/env python3
"""Serve the Mac clipboard as a PNG over localhost.

A small HTTP server that, on GET /, returns the current clipboard image as
image/png. Returns 204 if the clipboard has no image, 503 if pngpaste is not
installed. Used by the `csh` wrapper (which reverse-tunnels port 9876 into a
Codespace) and the codespace-side `pi` function to move images from the Mac
clipboard into the Codespace filesystem without a hotkey.

Port conflicts exit 0 silently so `csh`'s idempotent start-if-not-running
check stays simple.
"""
from __future__ import annotations

import http.server
import subprocess
import sys
import tempfile
from pathlib import Path

PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 9876


class ClipboardHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        tmp = Path(tempfile.mkstemp(suffix=".png")[1])
        try:
            try:
                result = subprocess.run(
                    ["pngpaste", str(tmp)], capture_output=True, timeout=3
                )
            except FileNotFoundError:
                self._respond(503, b"pngpaste not installed\n", "text/plain")
                return
            except subprocess.TimeoutExpired:
                self._respond(504, b"pngpaste timed out\n", "text/plain")
                return

            if result.returncode != 0 or not tmp.exists() or tmp.stat().st_size == 0:
                self._respond(204, b"", None)
                return

            self._respond(200, tmp.read_bytes(), "image/png")
        finally:
            tmp.unlink(missing_ok=True)

    def _respond(self, code: int, body: bytes, ctype: str | None) -> None:
        self.send_response(code)
        if ctype:
            self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if body:
            self.wfile.write(body)

    def log_message(self, *_args) -> None:  # silence default access log
        return


def main() -> int:
    try:
        server = http.server.HTTPServer(("127.0.0.1", PORT), ClipboardHandler)
    except OSError as e:
        if e.errno == 48:  # EADDRINUSE — another instance already listening
            return 0
        raise
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
