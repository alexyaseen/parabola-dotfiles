# Shared aliases — sourced by both .zshrc (macOS) and codespace.zshrc (Codespaces).

# --- Git ---
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gb='git branch'
alias gco='git checkout'
alias gcb='git checkout -b'

# --- Development ---
alias y='yarn'
alias nr='npm run'
alias npmr='npm run'
