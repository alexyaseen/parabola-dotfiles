{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(bob:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(test:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(xargs:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(tr:*)",
      "Bash(cut:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(tee:*)",
      "Bash(kill:*)",
      "Bash(lsof:*)",
      "Bash(sips:*)",
      "Bash(curl:*)",
      "Bash(command:*)",
      "Bash(for:*)",
      "Bash(if:*)",
      "Bash(while:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:parabola.io)",
      "mcp__figma-*"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "effortLevel": "high",
  "autoMode": {
    "allow": [
      "Standard development tools: compilers, linters, formatters, test runners, build tools",
      "File operations within the current working directory and its subdirectories",
      "Git operations on the current repository",
      "Package manager commands (npm, pnpm, yarn, npx)",
      "Docker and container operations",
      "Process management (kill, lsof) for development servers"
    ],
    "soft_deny": [
      "Network requests (WebFetch, curl, wget) to domains not explicitly allowlisted in permissions",
      "File modifications outside the current working directory tree",
      "Destructive operations: rm -rf, git reset --hard, git push --force, git clean",
      "Writing to system directories or dotfiles outside ~/.claude"
    ],
    "environment": [
      "File operations within the active project directory are safe and expected",
      "The user trusts standard dev tooling and wants minimal interruption for routine work"
    ]
  },
  "teammateMode": "tmux"
}
